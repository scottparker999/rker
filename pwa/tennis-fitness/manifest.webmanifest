{
  "id": "/log/",
  "name": "Tennis Fitness Tracker",
  "short_name": "Tennis Fitness",
  "description": "Strength training log for tennis: push, pull and upper + legs sessions, rest timer, lift trends and bodyweight.",
  "start_url": "/log/",
  "scope": "/log/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EEF1F4",
  "theme_color": "#FFFFFF",
  "icons": [
    { "src": "/pwa/tennis-fitness/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/tennis-fitness/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/tennis-fitness/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/pwa/tennis-fitness/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Today's session", "short_name": "Train", "url": "/log/#train",
      "icons": [{ "src": "/pwa/tennis-fitness/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Log bodyweight", "short_name": "Body", "url": "/log/#body",
      "icons": [{ "src": "/pwa/tennis-fitness/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
