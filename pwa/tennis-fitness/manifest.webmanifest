{
  "id": "/log/",
  "name": "Tennis Fitness Tracker",
  "short_name": "Tennis Fitness",
  "description": "Strength training log for tennis: push, pull and upper + legs sessions, rest timer, lift trends and bodyweight.",
  "start_url": "/log/",
  "scope": "/log/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#14202B",
  "theme_color": "#FFFFFF",
