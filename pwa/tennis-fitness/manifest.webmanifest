    {
      "src": "/pwa/tennis-fitness/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa/tennis-fitness/icon.svg?v=2",
      "sizes": "any",
