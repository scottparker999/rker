{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rker",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "LogStore" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LogStore"] }
  ],
  // Gym-day reminders: every day at 22:00 UTC (8am Brisbane); the Worker only
  // sends on training days.
  "triggers": { "crons": ["0 22 * * *"] },
  "vars": {
    // Zero Trust team name: the part before .cloudflareaccess.com
    "ACCESS_TEAM": "misty-brook-383f",
    // Application Audience (AUD) tag(s) of the Access app(s) covering /log and /api/log, comma-separated
    "ACCESS_AUD": "9fdf2b2e5999e86a6991771e9570de363058dbec292e1b5198d03a643f963473"
  }
}
